<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="stake_id">stake</variable>
    <variable id="multiplier_id">multiplier</variable>
    <variable id="velocity_push_id">velocity_push</variable>
    <variable id="is_mfi_hook_id">is_mfi_hook</variable>
    <variable id="is_adx_climbing_id">is_adx_climbing</variable>
  </variables>
  <block type="trade_definition" id="trade_def_main" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_block" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">step_index</field>
        <field name="SYMBOL_LIST">stpRNG</field>
        <next>
          <block type="trade_definition_tradetype" id="tradetype_block" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">callput</field>
            <next>
              <block type="trade_definition_contracttype" id="contracttype_block" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candleinterval_block" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="restart_block" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="restartonerror_block" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_stake_block">
        <field name="VAR" id="stake_id">stake</field>
        <value name="VALUE">
          <block type="math_number" id="stake_number">
            <field name="NUM">1</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_mult_block">
            <field name="VAR" id="multiplier_id">multiplier</field>
            <value name="VALUE">
              <block type="math_number" id="mult_number">
                <field name="NUM">2.1</field>
              </block>
            </value>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="tradeoptions_block">
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number_positive" id="duration_shadow">
            <field name="NUM">5</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <block type="variables_get" id="get_stake_block">
            <field name="VAR" id="stake_id">stake</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="before_block" deletable="false" x="0" y="500">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="variables_set" id="calc_velocity">
        <field name="VAR" id="velocity_push_id">velocity_push</field>
        <value name="VALUE">
          <block type="math_arithmetic" id="vel_diff">
            <field name="OP">MINUS</field>
            <value name="A">
              <block type="tick" id="current_tick"></block>
            </value>
            <value name="B">
              <block type="lists_getIndex" id="get_tick_5">
                <mutation statement="false" at="true"></mutation>
                <field name="MODE">GET</field>
                <field name="WHERE">FROM_END</field>
                <value name="VALUE">
                  <block type="ticks" id="tick_list"></block>
                </value>
                <value name="AT">
                  <block type="math_number" id="num_5">
                    <field name="NUM">5</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </value>
        <next>
          <block type="variables_set" id="calc_mfi">
            <field name="VAR" id="is_mfi_hook_id">is_mfi_hook</field>
            <value name="VALUE">
              <block type="logic_compare" id="rsi_hook_check">
                <field name="OP">GT</field>
                <value name="A">
                  <block type="rsi" id="rsi_val">
                    <value name="INPUT_LIST">
                      <block type="ticks" id="rsi_ticks"></block>
                    </value>
                    <value name="PERIOD">
                      <block type="math_number" id="rsi_period">
                        <field name="NUM">14</field>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number" id="rsi_50">
                    <field name="NUM">50</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="variables_set" id="calc_adx">
                <field name="VAR" id="is_adx_climbing_id">is_adx_climbing</field>
                <value name="VALUE">
                  <block type="logic_compare" id="ema_trend_check">
                    <field name="OP">GT</field>
                    <value name="A">
                      <block type="ema" id="ema_5">
                        <value name="INPUT_LIST">
                          <block type="ticks" id="ema_5_ticks"></block>
                        </value>
                        <value name="PERIOD">
                          <block type="math_number" id="ema_5_period">
                            <field name="NUM">5</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="ema" id="ema_10">
                        <value name="INPUT_LIST">
                          <block type="ticks" id="ema_10_ticks"></block>
                        </value>
                        <value name="PERIOD">
                          <block type="math_number" id="ema_10_period">
                            <field name="NUM">10</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="controls_if" id="early_strike_trigger">
                    <value name="IF0">
                      <block type="logic_operation" id="master_logic" inline="false">
                        <field name="OP">OR</field>
                        <value name="A">
                          <block type="logic_operation" id="standard_jury">
                            <field name="OP">AND</field>
                            <value name="A">
                              <block type="variables_get" id="get_mfi_hook">
                                <field name="VAR" id="is_mfi_hook_id">is_mfi_hook</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="variables_get" id="get_adx_climbing">
                                <field name="VAR" id="is_adx_climbing_id">is_adx_climbing</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <value name="B">
                          <block type="logic_compare" id="velocity_override">
                            <field name="OP">GT</field>
                            <value name="A">
                              <block type="variables_get" id="get_velocity">
                                <field name="VAR" id="velocity_push_id">velocity_push</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number" id="vel_threshold">
                                <field name="NUM">0.4</field>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="purchase" id="execute_call">
                        <field name="PURCHASE_LIST">CALL</field>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="after_block" x="700" y="170">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="result_condition_block">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="contract_result_block">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="reset_stake_block">
            <field name="VAR" id="stake_id">stake</field>
            <value name="VALUE">
              <block type="math_number" id="reset_number">
                <field name="NUM">1</field>
              </block>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="martingale_block">
            <field name="VAR" id="stake_id">stake</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="multiply_block">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <block type="variables_get" id="get_stake_mart_block">
                    <field name="VAR" id="stake_id">stake</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get" id="get_mult_block">
                    <field name="VAR" id="multiplier_id">multiplier</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </statement>
        <next>
          <block type="trade_again" id="trade_again_block"></block>
        </next>
      </block>
    </statement>
  </block>
</xml>
